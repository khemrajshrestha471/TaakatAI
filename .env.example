# -----------------------------------------------------------------------------
# TaakatAI environment variables
# Copy to `.env.local` and fill in. Run `pnpm env:check` to see what is missing.
# REQUIRED keys are marked (required). Everything else is optional: when a
# feature's keys are missing, that feature is disabled gracefully.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000          # (required) public base URL
NEXT_PUBLIC_APP_NAME=TaakatAI
ENCRYPTION_KEY=                                   # (required) 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Database — MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=                                      # (required)

# Auth — Auth.js
AUTH_SECRET=                                      # (required) Generate: npx auth secret
AUTH_GOOGLE_ID=                                   # Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=                                 # Meta for Developers → App → Facebook Login
AUTH_FACEBOOK_SECRET=

# AI — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                                  # e.g. claude-sonnet-5-5

# Media — Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Realtime — Pusher Channels dashboard → App Keys
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Video calls — Daily.co dashboard → Developers
DAILY_API_KEY=

# Email — Resend dashboard (verify your sending domain first)
RESEND_API_KEY=
EMAIL_FROM=                                       # e.g. "TaakatAI <no-reply@yourdomain.com>"

# Payments — PLATFORM credentials (SaaS billing to the platform owner).
# Coach/gym gateway keys are NOT env vars; they are entered in the workspace
# settings UI and stored encrypted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=                                  # sandbox: https://dev.khalti.com/api/v2
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_BASE_URL=                                   # sandbox: https://rc-epay.esewa.com.np

# Jobs / cache / push / monitoring
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VAPID_PUBLIC_KEY=                                 # Generate: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
SENTRY_DSN=
CRON_SECRET=                                      # any long random string
